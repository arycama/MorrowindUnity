#include "../Common.hlsl"
#include "Packages/com.arycama.customrenderpipeline/ShaderLibrary/Random.hlsl"

#pragma kernel Compute
#pragma kernel Accumulate
#pragma use_dxc
#pragma require waveMath
#pragma multi_compile _ SHADOWS_ON
#pragma multi_compile _ POINT_LIGHTS_ON

RWTexture3D<float4> Result;
Texture3D<float4> Input;

float4x4 PixelToWorldViewDir;

[numthreads(8, 8, 1)]
void Compute(uint3 id : SV_DispatchThreadID)
{
	float jitter = Noise1D(id.xy);
	float3 worldDir = MultiplyVector(PixelToWorldViewDir, float3(id.xy + 0.5, 1.0));
	float rcpWorldDirLength = RcpLength(worldDir);
	worldDir *= rcpWorldDirLength;
	
	float eyeDepth = (id.z + jitter) / VolumeSize.z * MaxDepth;
	
	float viewDistance = eyeDepth * rcp(rcpWorldDirLength);
	float3 worldPosition = ViewPosition + worldDir * viewDistance;
	
	float2 screenPosition = (id.xy + 0.5) / VolumeSize.xy;
	screenPosition.y = 1 - screenPosition.y;
	float2 pixelPosition = screenPosition * ViewSize;
	
	float3 illuminance;
	GetLuminance(0.0, worldPosition, pixelPosition, eyeDepth, illuminance);
	illuminance += AmbientLight;
	
	float extinction = viewDistance > FogStart && viewDistance < FogEnd ? rcp(FogEnd - viewDistance) : 0.0;
	float3 albedo = FogColor / (SunColor + AmbientLight);
	
	Result[id] = float4(albedo * illuminance, extinction);
}

[numthreads(8, 8, 1)]
void Accumulate(uint2 id : SV_DispatchThreadID)
{
	float3 worldDirection = MultiplyVector(PixelToWorldViewDir, float3(id + 0.5, 1.0));
	float rayLength = MaxDepth * length(worldDirection);
	float ds = rayLength / VolumeSize.z;
	
	float4 result = float2(0.0, 1.0).xxxy;
	for (float i = 0.0; i < VolumeSize.z; i++)
	{
		float4 luminanceExtinction = Input[uint3(id, i)];
		float transmittance = exp(-luminanceExtinction.a * ds);
		
		result.rgb += result.a * luminanceExtinction.rgb * (1.0 - transmittance);
		result.a *= transmittance;
		Result[uint3(id, i)] = result;
	}
}
