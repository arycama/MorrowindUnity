#include "../../Common.hlsl"
#include "Packages/com.arycama.customrenderpipeline/ShaderLibrary/Raytracing.hlsl"

#pragma max_recursion_depth 1

RWTexture2D<float> HitResult;

[shader("miss")]
void MissShader(inout RayTransmittancePayload payload : SV_RayPayload)
{
	payload.transmittance = 1.0;
}

[shader("raygeneration")]
void RayGeneration()
{
	uint2 position = DispatchRaysIndex().xy;
	float depth = CameraDepth[position];
	if (depth == 0.0)
		return;
		
	float4 normalOcclusionRoughness = GBufferNormalOcclusionRoughness[position];
	float2 noise2D = Noise2D(position);
	
	float3 N = PyramidUvToNormal(normalOcclusionRoughness.xy);
	
	float3 worldPosition = MultiplyPointProj(PixelToWorld, float3(position + 0.5, depth)).xyz;
	float3 V = MultiplyPoint3x4(WorldToView, normalize(-worldPosition));
	N = -FromToRotationZ(-V, N, false);
	N = MultiplyVector(ViewToWorld, N);
	
	worldPosition += ViewPosition;
	
	float visibility = 0.0;
	uint samples = 4;
	for (uint i = 0; i < samples; i++)
	{
		RayTransmittancePayload payload;
		payload.transmittance = 1.0;
		
		float2 u = Hammersley2dSeq(i, samples);
		u = frac(u + noise2D);
	
		float3 L = SampleHemisphereCosine(u, N);
		
		RayDesc ray;
		ray.Origin = worldPosition;
		ray.Direction = L;
		ray.TMin = 0.001;
		ray.TMax = 64;
		
		uint flags = RAY_FLAG_CULL_BACK_FACING_TRIANGLES | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH;
		TraceRay(SceneRaytracingAccelerationStructure, flags, 0xFF, 0, 1, 0, ray, payload);
		
		visibility += payload.transmittance;
	}
	
	HitResult[position] = visibility / samples;
}
